{
  "info": {
    "name": "Utility Billing System",
    "description": "WASAC/REG Utility Billing System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@wasac.rw\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Login Finance",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"finance@wasac.rw\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"New Customer\",\n  \"email\": \"newuser@example.com\",\n  \"phoneNumber\": \"+250788123456\",\n  \"password\": \"Password@123\",\n  \"role\": \"ROLE_CUSTOMER\"\n}"
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/verify-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"otpCode\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/customers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullNames\": \"Marie Uwase\",\n  \"nationalId\": \"1199080098765432\",\n  \"email\": \"marie@example.com\",\n  \"phoneNumber\": \"+250788654321\",\n  \"address\": \"KN 5 St, Kigali\",\n  \"status\": \"ACTIVE\"\n}"
            }
          }
        },
        {
          "name": "List Customers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/customers"
          }
        }
      ]
    },
    {
      "name": "Meters",
      "item": [
        {
          "name": "Create Meter",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/meters",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"meterNumber\": \"WTR-001-2026\",\n  \"meterType\": \"WATER\",\n  \"installationDate\": \"2025-01-15\",\n  \"status\": \"ACTIVE\",\n  \"customerId\": 1\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Readings",
      "item": [
        {
          "name": "Capture Reading",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/readings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"meterId\": 1,\n  \"previousReading\": 100.00,\n  \"currentReading\": 145.50,\n  \"readingDate\": \"2026-05-28\",\n  \"billingMonth\": 5,\n  \"billingYear\": 2026\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Billing",
      "item": [
        {
          "name": "Generate Bill",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/bills/generate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"readingId\": 1\n}"
            }
          }
        },
        {
          "name": "Record Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/payments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"billId\": 1,\n  \"amountPaid\": 10000.00,\n  \"paymentMethod\": \"MOBILE_MONEY\",\n  \"paymentDate\": \"2026-06-01\"\n}"
            }
          }
        }
      ]
    }
  ]
}
