// FILE 2B â€” SPRING BOOT FLOW DIAGRAM (Functionalities)
// Paste separately into https://mermaid.live
// ============================================================

```mermaid
flowchart TD
    START([User / Staff Opens API]) --> AUTH_CHECK{Authenticated?}

    AUTH_CHECK -->|No| PUBLIC["Public Endpoints\n/api/auth/signup\n/api/auth/login\n/api/auth/verify-otp\n/api/auth/resend-otp\n/api/auth/refresh-token"]
    AUTH_CHECK -->|Yes| JWT["JWT Filter validates token\n+ checks blacklist"]

    PUBLIC --> SIGNUP["Signup\nâ†’ validate email/password/phone\nâ†’ hash password\nâ†’ generate OTP\nâ†’ send email"]
    SIGNUP --> VERIFY["Verify OTP\nâ†’ mark email verified"]
    VERIFY --> LOGIN["Login\nâ†’ reject if unverified/inactive\nâ†’ issue access + refresh JWT"]

    PUBLIC --> LOGIN
    LOGIN --> ROLE{User Role?}

    JWT --> ROLE

    ROLE -->|ROLE_ADMIN| ADMIN_FLOW["Admin Functions"]
    ROLE -->|ROLE_OPERATOR| OP_FLOW["Operator Functions"]
    ROLE -->|ROLE_FINANCE| FIN_FLOW["Finance Functions"]
    ROLE -->|ROLE_CUSTOMER| CUST_FLOW["Customer Functions"]

    ADMIN_FLOW --> A1["Manage Users"]
    ADMIN_FLOW --> A2["Configure Tariffs\n(versioned, future cycles)"]
    ADMIN_FLOW --> A3["Manage Customers & Meters"]
    ADMIN_FLOW --> A4["View All Bills & Payments"]

    OP_FLOW --> O1["Capture Meter Reading\nâ†’ meter must be ACTIVE\nâ†’ current > previous\nâ†’ one reading per meter/month/year\nâ†’ auto-calc units consumed"]

    FIN_FLOW --> F1["Generate Bill from Reading\nâ†’ customer must be ACTIVE\nâ†’ apply active tariff\nâ†’ calc VAT + penalty\nâ†’ unique bill number"]
    FIN_FLOW --> F2["Record Payment\nâ†’ partial or full\nâ†’ prevent overpayment\nâ†’ update balance & status"]

    CUST_FLOW --> C1["View Own Bills"]
    CUST_FLOW --> C2["View Own Payments"]
    CUST_FLOW --> C3["View Own Notifications"]

    O1 --> BILL_GEN
    F1 --> BILL_GEN["Bill Generation"]
    BILL_GEN --> DB_TRIGGER["PostgreSQL Trigger\nAuto-insert notification\non bill creation"]
    DB_TRIGGER --> EMAIL1["EmailService sends bill notification"]

    F2 --> PAY_PROC["Payment Processing"]
    PAY_PROC --> UPDATE_BILL["Update amount_paid\noutstanding_balance\nbill status"]
    PAY_PROC --> DB_PROC["PostgreSQL Stored Procedure\nOn full payment:\nâ†’ set bill PAID\nâ†’ insert notification"]
    DB_PROC --> EMAIL2["EmailService sends payment confirmation"]

    LOGIN --> LOGOUT["Logout\nâ†’ blacklist JWT token"]
    JWT --> ME["GET /api/auth/me\nCurrent logged-in user"]

    style SIGNUP fill:#e8f4fd
    style VERIFY fill:#e8f4fd
    style LOGIN fill:#e8f4fd
    style BILL_GEN fill:#fff3cd
    style PAY_PROC fill:#d4edda
    style DB_TRIGGER fill:#f8d7da
    style DB_PROC fill:#f8d7da
```

